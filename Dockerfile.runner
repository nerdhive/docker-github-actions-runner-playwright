FROM myoung34/github-runner:ubuntu-noble@sha256:f72002c1960a613a51f7a1e0b173ba17dfbf2ecc22ea098b3b09f8bf6331872a

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG NODE_VERSION=24.11.1
ARG PNPM_VERSION=10.12.4
# Unpinned apt packages below (ca-certificates, curl, ffmpeg, xz-utils) have no
# version string, so Renovate has nothing to bump. CACHEBUST is set to the
# workflow run ID only on the scheduled weekly rebuild (see
# build-runner-image.yml), which busts this layer's build cache so
# `apt-get update && install` actually re-resolves against Ubuntu's current
# noble repo instead of reusing a stale cached layer.
ARG CACHEBUST=0

ENV DEBIAN_FRONTEND=noninteractive \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PLAYWRIGHT_SKIP_BROWSER_GC=1 \
    PNPM_HOME=/pnpm \
    PNPM_STORE_DIR=/pnpm-store \
    PATH=/pnpm:/usr/local/bin:${PATH}

USER root
WORKDIR /tmp/playwright-install

RUN echo "cachebust=${CACHEBUST}" > /dev/null \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    ffmpeg \
    xz-utils \
 && rm -rf /var/lib/apt/lists/*

RUN arch="$(dpkg --print-architecture)" \
 && case "${arch}" in \
      amd64) node_arch='x64' ;; \
      arm64) node_arch='arm64' ;; \
      *) echo "Unsupported architecture: ${arch}" >&2; exit 1 ;; \
    esac \
 && curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" \
 && tar -xJf "node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" -C /usr/local --strip-components=1 --no-same-owner \
 && rm "node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" \
 && node --version \
 && npm --version

RUN perl -0pi -e 's/if \[ -n "\$\{EPHEMERAL\}" \]; then/if [ -n "\$\{EPHEMERAL\}" ] \&\& [ "\$\{EPHEMERAL\}" != "false" ] \&\& [ "\$\{EPHEMERAL\}" != "0" ]; then/' /entrypoint.sh

COPY package.json ./package.json

RUN corepack enable \
 && corepack prepare "pnpm@${PNPM_VERSION}" --activate \
 && pnpm config set store-dir "${PNPM_STORE_DIR}" \
 && mkdir -p /ms-playwright /pnpm-store /runner/_work \
 && chmod 0777 /ms-playwright /pnpm-store /runner/_work \
 && pnpm install --ignore-scripts --frozen-lockfile=false \
 && pnpm exec playwright install --with-deps chromium \
 && pnpm store prune \
 && rm -rf /root/.npm /tmp/playwright-install/node_modules

WORKDIR /actions-runner
